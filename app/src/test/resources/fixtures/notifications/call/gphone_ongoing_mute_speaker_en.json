{
  "pkg": "com.google.android.dialer",
  "appLabel": "Phone",
  "locale": "en-US",
  "category": "call",
  "template": "android.app.Notification$CallStyle",
  "importance": 4,
  "flags": [
    "ONGOING_EVENT",
    "FOREGROUND_SERVICE"
  ],
  "when": -65000,
  "intents": [
    "android.hangUpIntent"
  ],
  "callPerson": {
    "name": "Sam Carter"
  },
  "extras": {
    "android.title": "Sam Carter",
    "android.text": "Ongoing call",
    "android.callType": 2,
    "android.showChronometer": true
  },
  "actions": [
    {
      "title": "Mute"
    },
    {
      "title": "Speaker"
    },
    {
      "title": "Hang up"
    }
  ],
  "source": "synthetic (CallStyle.forOngoingCall, Google Phone)"
}
